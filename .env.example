# Copy to .env.local and fill in.

# ── Database ──
# Supabase: Project Settings → Database → Connection string (Transaction pooler, port 6543).
# Local without Supabase: run `npm run db:local` and use the line below.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
# 1 while using the local PGlite server; remove (or 0) with Supabase.
DATABASE_LOCAL=1
# Connections per server instance in production.
DATABASE_POOL_MAX=10

# ── Supabase (OTP sign-in + file storage) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Only for projects still on the legacy HS256 JWT secret; otherwise tokens are checked against the project's JWKS.
SUPABASE_JWT_SECRET=
STORAGE_BUCKET_UPLOADS=uploads
STORAGE_BUCKET_IMAGES=question-images
# auto = Supabase Storage when SUPABASE_SERVICE_ROLE_KEY is set, otherwise files are kept on
# this computer in LOCAL_STORAGE_DIR and served by /api/files (laptop testing only).
STORAGE_DRIVER=auto
LOCAL_STORAGE_DIR=.local-storage

# ── Claude (document extraction + "Ask") ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise the built-in parser, which reads typed
# DOCX/TXT/PDF papers (no photos, no drafted explanations). Set to "local" to force the parser.
EXTRACTOR=auto
ASK_DAILY_LIMIT=5

# ── Web push ── generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@intelqa.app

# ── Daily job ── (POST /api/jobs/daily with "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=change-me

# ── Local development only ──
# API smoke test only (npm run db:seed:demo, laptop database): lets scripts/smoke.mjs act as the
# test accounts through an x-dev-user header. No effect on the sign-in screen; never active in production.
DEV_AUTH=0
