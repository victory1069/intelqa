{
  "name": "intelqa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:local": "pglite-server --db=./.pglite --port=5433 --max-connections=20",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:seed:demo": "tsx src/server/db/seed.ts --demo",
    "job:daily": "tsx src/server/jobs/run-daily.ts",
    "job:morning": "tsx src/server/jobs/run-daily.ts morning",
    "job:evening": "tsx src/server/jobs/run-daily.ts evening"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.4.7",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.13.0",
    "hono": "^4.13.17",
    "jose": "^6.2.15",
    "katex": "^0.19.1",
    "lenis": "^1.3.4",
    "mammoth": "^1.13.0",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "unpdf": "^0.12.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@tailwindcss/turbopack": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
